# Copy to backend/.env (never commit real secrets)
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://cyclecoach:cyclecoach@localhost:5432/cyclecoach
REDIS_URL=redis://localhost:6379/0
# SECURITY: production refuses to boot with this placeholder, an empty value,
# or a secret shorter than 32 characters. Generate a unique secret per
# environment (at least 32 characters) and supply it via the environment.
SECRET_KEY=change-me-in-production-min-32-chars
# Email delivery: only "dev" is implemented (bounded in-memory outbox for
# development/test). Production refuses to boot without a real provider.
EMAIL_PROVIDER=dev
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=60
EMAIL_VERIFY_HOURS=24

# Phase 7 — AI Coach. Off by default: with these as-is the coach returns the
# deterministic answer assembled from the training engine, which needs no key.
# Set AI_API_KEY only in the server environment; it is never sent to the client.
AI_ENABLED=false
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_REQUESTS_PER_USER=20
AI_REQUEST_RETRY_LIMIT=1
AI_MAX_MESSAGE_CHARS=1000
AI_MAX_CONTEXT_ACTIVITIES=7
# USD per 1k tokens. Left at 0 the daily budget is not enforced, because an
# invented price would be a fabricated number; the token caps do the bounding.
AI_DAILY_COST_LIMIT=1.0
AI_INPUT_COST_PER_1K_TOKENS=0.0
AI_OUTPUT_COST_PER_1K_TOKENS=0.0
