# Flutter, Python, secrets — never commit these
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
.idea/
.vscode/
*.iml

# Python
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
!.env.example
pytest_cache/
