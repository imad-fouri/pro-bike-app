<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY: this file lives under src/debug, so it is merged into
     debug builds and never into release builds.

     It permits cleartext HTTP so a physical phone on the same trusted LAN can
     reach a development API at http://<COMPUTER-LAN-IP>:8000 (Android 9+
     blocks cleartext by default). Release builds keep the platform default,
     which blocks cleartext on API 28+, and stay HTTPS-only.

     No host is hardcoded here: the API URL always comes from the
     API_BASE dart-define build flag. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
